# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your-bot-token
# Target channel (@username or -100... ID) for digest posts; if empty, sends to owner DM
TELEGRAM_CHANNEL_ID=
# Comma-separated Telegram user IDs allowed to control the bot (recommended!)
ALLOWED_USER_IDS=123456789

# Gemini API
GOOGLE_API_KEY=your-gemini-api-key
# Step 1: fast batch selection & deduplication (500 RPD tier)
GEMINI_FILTER_MODEL=gemini-3.1-flash-lite
# Step 2: final digest writing (beta uses flash-lite; switch to Hydrogen later)
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
# Comma-separated fallbacks across tiers/generations if primary hits 429 or 503
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-2.5-flash,gemini-2.5-flash-lite
# Exponential backoff rounds for transient 503/429 spikes
GEMINI_MAX_ATTEMPTS=5
GEMINI_BACKOFF_BASE_SECONDS=10
GEMINI_BACKOFF_MAX_SECONDS=90

# Optional GitHub token (increases rate limit from 60 to 5000 req/hour)
GITHUB_TOKEN=

# Digest Schedule (24h format, local timezone)
TIMEZONE=Europe/Moscow
MORNING_DIGEST_TIME=09:00
EVENING_DIGEST_TIME=20:00

# Pipeline Tuning
LOOKBACK_HOURS=16
MAX_CANDIDATES_FOR_LLM=70
TOP_ITEMS_TO_SUMMARIZE=12
HTTP_TIMEOUT_SECONDS=20
SOURCES_PATH=config/sources.json
DB_PATH=data/bot.db
